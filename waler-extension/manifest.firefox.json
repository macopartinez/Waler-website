{
  "manifest_version": 2,
  "name": "Waler - Instagram Analytics",
  "version": "1.0.0",
  "description": "Track your Instagram followers, unfollowers, and engagement in real-time",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "cookies",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://i.instagram.com/*",
    "https://waler.website/*"
  ],
  "background": {
    "scripts": ["dist/background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["dist/content/instagram-tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://waler.website/*"],
      "js": ["dist/content/auth-listener.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "browser_action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "web_accessible_resources": ["injected/page-script.js"],
  "browser_specific_settings": {
    "gecko": {
      "id": "waler@waler.website",
      "strict_min_version": "91.0"
    }
  }
}
